{
  "name": "agendaya-tp6-grupo4",
  "version": "1.0.0",
  "private": true,
  "description": "AgendaYA - TP N6 Testing automatizado (Ingenieria y Calidad de Software - UTN FRM, Grupo 4)",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "reset": "node server/reset-db.js",
    "test:unit": "jest --verbose",
    "test:coverage": "jest --coverage",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:e2e": "start-server-and-test start http://localhost:3000 cy:run",
    "test:e2e:open": "start-server-and-test start http://localhost:3000 cy:open",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "cypress": "^13.17.0",
    "jest": "^29.7.0",
    "start-server-and-test": "^3.0.12"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "collectCoverageFrom": [
      "src/logica/**/*.js",
      "server/seguridad.js"
    ]
  }
}
